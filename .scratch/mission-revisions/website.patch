+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const test = require('node:test');
+const Persistence = require('./planner-persistence.js');
+
+test('browser sends revisions, blocks stale autosaves and relinks only after Save as new succeeds', async () => {
+    const source = fs.readFileSync(path.join(__dirname, 'main.js'), 'utf8');
+    const start = source.indexOf('// Save current mission draft to the Django beta account.');
+    const end = source.indexOf('\n})();', start) + '\n})();'.length;
+    const requests = [];
+    let conflict = false;
+    const missionDraft = {
+        currentMissionId: 7, serverRevision: 1, changeRevision: 0,
+        missionState: { name: 'Survey', polygon: [[1, 1], [1, 2], [2, 2]], settings: {} },
+        prepareSave() { return { hasArea: true, hasRoute: true, payload: this.missionState }; },
+        syncSaveStatus() {}, markSaved() {},
+        markSaveError(message, action) { this.errorAction = action; },
+    };
+    const status = { dataset: { saveUrl: '/save/' } };
+    const context = {
+        readOnly: false, missionDraft, mapSurface: {},
+        DOM: { save: { plannerSaveStatus: status, plannerSaveStatusText: {}, btnSaveStatusAction: { addEventListener() {} } }, rail: {} },
+        SaveStatus: { create: () => ({}) },
+        Persistence: {
+            ...Persistence,
+            async sendSaveRequest({ payload }) {
+                requests.push(payload);
+                if (conflict && payload.id) throw Object.assign(new Error('Changed'), { status: 409 });
+                return { mission: { id: payload.id || 8, revision: payload.id ? payload.revision + 1 : 1, name: payload.name } };
+            },
+        },
+        document: { querySelector: () => null, dispatchEvent() {} },
+        window: { location: { pathname: '/planner/' }, history: { replaceState() {} } },
+        getCookie: () => '', applySavedMission() {}, setTimeout, clearTimeout, Event,
+    };
+    vm.runInNewContext(source.slice(start, end), context);
+    assert.equal(await missionDraft.saveMission(), true);
+    assert.equal(requests[0].revision, 1);
+    assert.equal(missionDraft.serverRevision, 2);
+
+    conflict = true;
+    assert.equal(await missionDraft.saveMission(), false);
+    assert.equal(missionDraft.errorAction, 'resolve');
+    assert.equal(missionDraft.currentMissionId, 7);
+    assert.equal(missionDraft.serverRevision, 2);
+    assert.equal(missionDraft.missionState.name, 'Survey');
+    missionDraft.scheduleAutosave(0);
+    assert.equal(await missionDraft.saveMission({ automatic: true }), false);
+    await new Promise(resolve => setTimeout(resolve, 5));
+    assert.equal(requests.length, 2, 'A conflict must stop automatic retries');
+
+    assert.equal(await missionDraft.saveMission({ saveAsNew: true, copyName: 'Survey copy' }), true);
+    assert.equal(requests[2].id, null);
+    assert.equal(requests[2].revision, null);
+    assert.equal(missionDraft.currentMissionId, 8);
+    assert.equal(missionDraft.serverRevision, 1);
+});
